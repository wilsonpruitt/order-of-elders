{
  "framework": "astro",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/_astro/(.*)$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(?!_astro/|assets/|favicon\\.svg)(.*)$",
      "dest": "/riotexas/$1",
      "has": [{ "type": "host", "value": "riotexas.orderofelders.org" }],
      "check": true
    },
    { "handle": "filesystem" },
    { "src": "^(?!/api).*$", "status": 404, "dest": "/404.html" }
  ]
}
