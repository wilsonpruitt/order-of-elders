---
import Base from "../../../layouts/Base.astro";
import Masthead from "../../../components/Masthead.astro";
import PrayerWall from "../../../components/PrayerWall.astro";
import Calendar from "../../../components/Calendar.astro";
import { publishedPrayers, publishedEvents } from "../../../lib/content";

const prayers = (await publishedPrayers("deacons", "riotexas")).slice(0, 3);
const events = await publishedEvents("deacons", "riotexas");

const submitHref = `mailto:hello@orderofdeacons.org?subject=${encodeURIComponent("Prayer request — Order of Deacons")}`;
---
<Base
  order="deacons"
  title="Order of Deacons · Río Texas Conference"
  description="The shared home of the deacons of the Río Texas Annual Conference — a public prayer wall and the calendar of the order."
  image="https://riotexas.orderofdeacons.org/og-riotexas.png"
  url="https://riotexas.orderofdeacons.org/"
>
  <Masthead order="deacons" title="The Order of Deacons" conferenceLabel="Río Texas Conference" />

  <main>
    <section class="wrap greet">
      <div>
        <p class="label" style="color:var(--red)">Grace and peace</p>
        <h2>Watching over one another in love</h2>
        <p>This is the shared home of the deacons of the Río Texas Annual Conference — a place for the prayers we carry together and the days we set apart to gather. Everything here is public on purpose: the covenant of the order, made visible.</p>
        <a class="cta" href="#prayers">Submit a prayer request</a>
      </div>
      <blockquote class="verse">
        "Ordained by a bishop to a lifetime ministry of Word, Service, Compassion, and Justice."
        <cite>The Book of Discipline, &para; 329.1</cite>
      </blockquote>
    </section>

    <PrayerWall prayers={prayers} submitHref={submitHref} />

    <Calendar events={events} />

  </main>

  <Fragment slot="footer">
    <span class="mark">The Order of Deacons &middot; Río Texas</span>
    <blockquote>"All clergy of The United Methodist Church are charged to maintain all confidences inviolate." &mdash; &para; 341</blockquote>
    <p>An independent project of the order. Part of <a href="https://orderofdeacons.org">orderofdeacons.org</a>. Prayer requests are moderated before publication.</p>
  </Fragment>
</Base>

<style>
  h2.sec { color: var(--ink); }

  /* ---------- greeting ---------- */
  .greet { padding: 72px 0 64px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: end; }
  @media (max-width: 760px) { .greet { grid-template-columns: 1fr; gap: 28px; padding-top: 52px; } }
  .greet h2 { font-family: "EB Garamond", serif; font-weight: 500; font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.12; margin: .5rem 0 1.1rem; }
  .greet p { max-width: 56ch; color: #3B362E; }
  .cta {
    display: inline-block; margin-top: 1.4rem; padding: 14px 26px;
    background: var(--red); color: #F7F3EA; border: none;
    font-family: "Archivo", sans-serif; font-weight: 600; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
  }
  .cta:hover { background: var(--red-deep); text-decoration: none; }
  .verse {
    border-left: 3px solid var(--gold); padding: 6px 0 6px 22px;
    font-family: "EB Garamond", serif; font-style: italic; font-size: 1.15rem; color: var(--red-deep);
  }
  .verse cite { display: block; margin-top: .7rem; font-style: normal; font-family: "Archivo", sans-serif; font-size: .7rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--smoke); }
</style>
