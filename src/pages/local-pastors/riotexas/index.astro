---
import Base from "../../../layouts/Base.astro";
import Masthead from "../../../components/Masthead.astro";
import PrayerWall from "../../../components/PrayerWall.astro";
import Calendar from "../../../components/Calendar.astro";
import { publishedPrayers, publishedEvents } from "../../../lib/content";

const prayers = (await publishedPrayers("local-pastors", "riotexas")).slice(0, 3);
const events = await publishedEvents("local-pastors", "riotexas");

const submitHref = `mailto:hello@fellowshipoflocalpastors.org?subject=${encodeURIComponent("Prayer request — Fellowship of Local Pastors and Associate Members")}`;
---
<Base
  order="local-pastors"
  title="Fellowship of Local Pastors and Associate Members · Río Texas Conference"
  description="The shared home of the local pastors and associate members of the Río Texas Annual Conference — a public prayer wall and the calendar of the Fellowship."
  image="https://riotexas.fellowshipoflocalpastors.org/og-riotexas.png"
  url="https://riotexas.fellowshipoflocalpastors.org/"
>
  <Masthead order="local-pastors" title="The Fellowship of Local Pastors" conferenceLabel="Río Texas Conference" />

  <main>
    <section class="wrap greet">
      <div>
        <p class="label" style="color:var(--red)">Grace and peace</p>
        <h2>Mutual support, for the mission</h2>
        <p>This is the shared home of the local pastors and associate members of the Río Texas Annual Conference — a place for the prayers we carry together and the days we set apart to gather. Everything here is public on purpose: the life of the Fellowship, made visible.</p>
        <a class="cta" href="#prayers">Submit a prayer request</a>
      </div>
      <blockquote class="verse">
        "Licensed pastors share with the elders the responsibilities and duties of a pastor for this fourfold ministry, within the context of their appointment."
        <cite>The Book of Discipline, &para; 340.2</cite>
      </blockquote>
    </section>

    <PrayerWall prayers={prayers} submitHref={submitHref} />

    <Calendar events={events} />

  </main>

  <Fragment slot="footer">
    <span class="mark">The Fellowship of Local Pastors &middot; Río Texas</span>
    <blockquote>"To maintain all confidences inviolate." &mdash; &para; 340.2.a(5)</blockquote>
    <p>An independent project of the Fellowship. Part of <a href="https://fellowshipoflocalpastors.org">fellowshipoflocalpastors.org</a>. Prayer requests are moderated before publication.</p>
  </Fragment>
</Base>

<style>
  h2.sec { color: var(--ink); }

  /* ---------- greeting ---------- */
  .greet { padding: 72px 0 64px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: end; }
  @media (max-width: 760px) { .greet { grid-template-columns: 1fr; gap: 28px; padding-top: 52px; } }
  .greet h2 { font-family: "EB Garamond", serif; font-weight: 500; font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.12; margin: .5rem 0 1.1rem; }
  .greet p { max-width: 56ch; color: #3B362E; }
  .cta {
    display: inline-block; margin-top: 1.4rem; padding: 14px 26px;
    background: var(--red); color: #F7F3EA; border: none;
    font-family: "Archivo", sans-serif; font-weight: 600; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
  }
  .cta:hover { background: var(--red-deep); text-decoration: none; }
  .verse {
    border-left: 3px solid var(--gold); padding: 6px 0 6px 22px;
    font-family: "EB Garamond", serif; font-style: italic; font-size: 1.15rem; color: var(--red-deep);
  }
  .verse cite { display: block; margin-top: .7rem; font-style: normal; font-family: "Archivo", sans-serif; font-size: .7rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--smoke); }
</style>
