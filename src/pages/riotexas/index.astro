---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { formatFullDate, formatMonthYear, formatShortMonth, formatDay } from "../../lib/dates";

const letters = (await getCollection("letters"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const prayers = (await getCollection("prayers"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const events = (await getCollection("events"))
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
---
<Base title="Order of Elders · Río Texas Conference">
  <header class="mast">
    <div class="rules" aria-hidden="true"></div>
    <div class="wrap bar">
      <span class="label conf">Río Texas Conference</span>
      <h1>The Order of Elders</h1>
      <nav aria-label="Site">
        <a href="#letters">Letters</a>
        <a href="#prayers">Prayer Wall</a>
        <a href="#calendar">Calendar</a>
        <a href="#map">Map</a>
        <a href="#directory" class="lock" title="Members only — coming soon">Directory</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap greet">
      <div>
        <p class="label" style="color:var(--red)">Grace and peace</p>
        <h2>Watching over one another in love</h2>
        <p>This is the shared home of the elders of the Río Texas Annual Conference — a place for the letters we write one another, the prayers we carry together, and the days we set apart to gather. Everything here is public on purpose: the covenant of the order, made visible.</p>
        <a class="cta" href="#prayers">Submit a prayer request</a>
      </div>
      <blockquote class="verse">
        "Elders have a fourfold ministry of Word, Sacrament, Order, and Service."
        <cite>The Book of Discipline, &para; 340</cite>
      </blockquote>
    </section>

    <section class="prayers" id="prayers">
      <div class="wrap">
        <div class="head">
          <div>
            <p class="label" style="color:var(--red)">The Prayer Wall</p>
            <h2 class="sec">Prayers of the order</h2>
          </div>
          <a
            class="more"
            href={`mailto:hello@orderofelders.org?subject=${encodeURIComponent("Prayer request — Order of Elders")}`}
          >Submit a request &rarr;</a>
        </div>
        <div class="wall">
          {prayers.map((prayer) => (
            <article class:list={["prayer", { answered: prayer.data.status === "answered" }]}>
              <div class="meta">
                <span>{formatFullDate(prayer.data.date)}</span>
                {prayer.data.kind === "thanksgiving" && <span class="tag">Thanksgiving</span>}
              </div>
              <p>{prayer.data.request}</p>
              <span class="who">&mdash; {prayer.data.attribution ?? "submitted by a member of the order"}</span>
            </article>
          ))}
        </div>
        <p class="note">Requests are reviewed before posting. Please share only what is yours to share — first names or initials for others, and no medical or personal details without consent.</p>
      </div>
    </section>

    <section class="letters" id="letters">
      <div class="wrap">
        <p class="label" style="color:var(--red)">From the Chair</p>
        <h2 class="sec">Letters to the order</h2>
        {letters.map((letter) => (
          <article class="letter">
            <time>{formatMonthYear(letter.data.date)}</time>
            <div>
              <h3><a href={`/riotexas/letters/${letter.id}`}>{letter.data.title}</a></h3>
              <p>{letter.data.excerpt}</p>
            </div>
          </article>
        ))}
        <p style="margin-top:1.4rem"><a class="more" href="#letters">Read all letters &rarr;</a></p>
      </div>
    </section>

    <section class="cal" id="calendar">
      <div class="wrap">
        <p class="label" style="color:var(--red)">Calendar</p>
        <h2 class="sec">Gatherings of the order</h2>

        {events.map((event) => (
          <div class="event">
            <div class="date">
              <span class="m">{formatShortMonth(event.data.start)}</span>
              <span class="d">{formatDay(event.data.start)}</span>
            </div>
            <div>
              <span class="kind">{event.data.kind}</span>
              <h3>{event.data.title}</h3>
              {event.data.location && <p class="where">{event.data.location}</p>}
            </div>
          </div>
        ))}

        <p class="subscribe"><a class="more" href="/calendar.ics">Subscribe to the calendar (.ics) &rarr;</a></p>
      </div>
    </section>

    <section class="map" id="map">
      <div class="wrap">
        <p class="label" style="color:var(--red)">The order, appointed</p>
        <h2 class="sec">Where the elders serve</h2>
        <div class="mapframe" role="img" aria-label="Map of appointments across the Río Texas Conference">
          Map coming soon &middot; appointments across Río Texas
        </div>
      </div>
    </section>

    <section class="dir" id="directory">
      <div class="wrap">
        <div class="dircard">
          <span class="glyph" aria-hidden="true">&#9919;</span>
          <div>
            <h3>Directory of the order &mdash; coming in version two</h3>
            <p>Contact information, appointment details, and member pages will live behind a simple sign-in, so the order can find one another without publishing anyone's phone number to the open web. Everything else on this site stays public.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="footer">
    <span class="mark">The Order of Elders &middot; Río Texas</span>
    <blockquote>"To maintain all confidences inviolate." &mdash; &para; 340</blockquote>
    <p>An independent project of the order. Part of <a href="https://orderofelders.org">orderofelders.org</a>. Prayer requests are moderated before publication.</p>
  </Fragment>
</Base>

<style>
  h2.sec { color: var(--ink); }

  /* ---------- masthead: the stole seen edge-on ---------- */
  .mast { border-bottom: 1px solid var(--hair); }
  .mast .rules {
    height: 10px;
    background: linear-gradient(var(--red) 0 3px, transparent 3px 7px, var(--red) 7px 10px);
  }
  .mast .bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px; padding: 22px 0; }
  .mast .conf { color: var(--smoke); }
  .mast h1 { font-family: "EB Garamond", serif; font-weight: 600; font-size: 1.5rem; letter-spacing: .01em; }
  nav { margin-left: auto; display: flex; gap: 22px; flex-wrap: wrap; }
  nav a { font-family: "Archivo", sans-serif; font-weight: 600; font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  nav a:hover { color: var(--red); text-decoration: none; }
  nav .lock { color: var(--smoke); }
  nav .lock::after { content: " \26BF"; color: var(--gold); }

  /* ---------- greeting ---------- */
  .greet { padding: 72px 0 64px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: end; }
  @media (max-width: 760px) { .greet { grid-template-columns: 1fr; gap: 28px; padding-top: 52px; } }
  .greet h2 { font-family: "EB Garamond", serif; font-weight: 500; font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.12; margin: .5rem 0 1.1rem; }
  .greet p { max-width: 56ch; color: #3B362E; }
  .cta {
    display: inline-block; margin-top: 1.4rem; padding: 14px 26px;
    background: var(--red); color: #F7F3EA; border: none;
    font-family: "Archivo", sans-serif; font-weight: 600; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
  }
  .cta:hover { background: var(--red-deep); text-decoration: none; }
  .verse {
    border-left: 3px solid var(--gold); padding: 6px 0 6px 22px;
    font-family: "EB Garamond", serif; font-style: italic; font-size: 1.15rem; color: var(--red-deep);
  }
  .verse cite { display: block; margin-top: .7rem; font-style: normal; font-family: "Archivo", sans-serif; font-size: .7rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--smoke); }

  /* ---------- prayer wall ---------- */
  .prayers { border-top: 1px solid var(--hair); padding: 72px 0; }
  .prayers .head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .wall { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 8px; }
  @media (max-width: 860px) { .wall { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 580px) { .wall { grid-template-columns: 1fr; } }
  .prayer { background: #FBFAF5; border: 1px solid var(--hair); border-top: 3px solid var(--red); padding: 26px 26px 22px; display: flex; flex-direction: column; gap: .7rem; }
  .prayer.answered { border-top-color: var(--gold); }
  .prayer .meta { display: flex; justify-content: space-between; gap: 10px; font-family: "Archivo", sans-serif; font-size: .7rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; color: var(--smoke); }
  .prayer .meta .tag { color: var(--gold); }
  .prayer p { font-size: .98rem; color: #3B362E; flex: 1; }
  .prayer .who { font-family: "EB Garamond", serif; font-style: italic; color: var(--smoke); }
  .prayers .note { margin-top: 26px; font-size: .9rem; color: var(--smoke); max-width: 66ch; }

  /* ---------- letters ---------- */
  .letters { border-top: 1px solid var(--hair); padding: 72px 0; }
  .letter { display: grid; grid-template-columns: 150px 1fr; gap: 28px; padding: 30px 0; border-bottom: 1px solid var(--hair); }
  @media (max-width: 580px) { .letter { grid-template-columns: 1fr; gap: 6px; } }
  .letter:last-of-type { border-bottom: none; }
  .letter time { font-family: "Archivo", sans-serif; font-size: .75rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; color: var(--smoke); padding-top: .5rem; }
  .letter h3 { font-family: "EB Garamond", serif; font-weight: 600; font-size: 1.45rem; margin-bottom: .3rem; }
  .letter h3 a { color: var(--ink); }
  .letter h3 a:hover { color: var(--red); }
  .letter p { font-size: .97rem; color: #3B362E; max-width: 62ch; }

  /* ---------- calendar ---------- */
  .cal { border-top: 1px solid var(--hair); padding: 72px 0; }
  .event { display: grid; grid-template-columns: 96px 1fr auto; gap: 24px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--hair); }
  @media (max-width: 580px) { .event { grid-template-columns: 72px 1fr; } }
  .date { border: 1px solid var(--red); text-align: center; padding: 10px 6px; font-family: "Archivo", sans-serif; font-weight: 600; text-transform: uppercase; }
  .date .m { display: block; font-size: .66rem; letter-spacing: .16em; color: var(--red); }
  .date .d { display: block; font-family: "EB Garamond", serif; font-weight: 600; font-size: 1.7rem; line-height: 1.1; color: var(--ink); }
  .event h3 { font-family: "EB Garamond", serif; font-weight: 600; font-size: 1.3rem; }
  .event .where { font-size: .9rem; color: var(--smoke); }
  .event .kind { font-family: "Archivo", sans-serif; font-size: .68rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); }
  .cal .subscribe { margin-top: 26px; }

  /* ---------- map ---------- */
  .map { border-top: 1px solid var(--hair); padding: 72px 0; }
  .mapframe {
    height: 340px; border: 1px solid var(--hair);
    background:
      radial-gradient(circle at 30% 40%, rgba(138,31,45,.14) 0 5px, transparent 6px),
      radial-gradient(circle at 62% 30%, rgba(138,31,45,.14) 0 5px, transparent 6px),
      radial-gradient(circle at 48% 62%, rgba(138,31,45,.14) 0 5px, transparent 6px),
      radial-gradient(circle at 76% 70%, rgba(138,31,45,.14) 0 5px, transparent 6px),
      linear-gradient(#EDEAE0, #E5E1D4);
    display: grid; place-items: center; color: var(--smoke);
    font-family: "Archivo", sans-serif; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase;
  }

  /* ---------- directory (locked teaser) ---------- */
  .dir { border-top: 1px solid var(--hair); padding: 72px 0; }
  .dircard { border: 1px dashed var(--gold); padding: 40px; max-width: 720px; display: flex; gap: 26px; align-items: flex-start; background: #FBFAF5; }
  @media (max-width: 580px) { .dircard { flex-direction: column; } }
  .dircard .glyph { font-size: 1.9rem; color: var(--gold); line-height: 1; }
  .dircard h3 { font-family: "EB Garamond", serif; font-weight: 600; font-size: 1.4rem; margin-bottom: .4rem; }
  .dircard p { font-size: .95rem; color: #3B362E; max-width: 56ch; }
</style>
