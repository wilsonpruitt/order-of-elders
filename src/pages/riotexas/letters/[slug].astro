---
import Base from "../../../layouts/Base.astro";
import { render } from "astro:content";
import { published, relatedLetters } from "../../../lib/content";
import { formatFullDate } from "../../../lib/dates";
import { FACETS, tagLabel } from "../../../lib/tags";
import { bookOf, bookSlug, bookName } from "../../../lib/osis";

export async function getStaticPaths() {
  const letters = await published("letters");
  return letters.map((letter) => ({
    params: { slug: letter.id },
    props: { letter },
  }));
}

const { letter } = Astro.props;
const { Content } = await render(letter);
const related = await relatedLetters(letter);

const tagged = FACETS.map((facet) => ({
  key: facet.key,
  label: facet.label,
  tags: letter.data.tags[facet.key],
})).filter((f) => f.tags.length > 0);

// The lectionary appoints two tracks in Ordinary Time, so the same role appears
// twice. Dedupe on the reference itself, not the role.
const readings = letter.data.readings.filter(
  (r, i, all) => all.findIndex((o) => o.refKey === r.refKey) === i,
);
---
<Base
  title={`${letter.data.title} · The Order of Elders`}
  description={letter.data.excerpt}
  image="https://riotexas.orderofelders.org/og-riotexas.png"
  url={`https://riotexas.orderofelders.org/letters/${letter.id}`}
>
  <header class="mast">
    <div class="rules" aria-hidden="true"></div>
    <div class="wrap bar">
      <span class="label conf">Río Texas Conference</span>
      <h1><a href="/">The Order of Elders</a></h1>
      <nav aria-label="Site">
        <a href="/#letters">Letters</a>
        <a href="/#prayers">Prayer Wall</a>
        <a href="/#calendar">Calendar</a>
        <a href="/#map">Map</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap letter-layout">
      <article class="letter-detail">
        <p class="label" style="color:var(--red)">
          {letter.data.kind === "announcement" ? "To the Order" : "From the Chair"}
        </p>
        <time>
          {formatFullDate(letter.data.date)}
          {letter.data.occasion && <span class="occ">&middot; {letter.data.occasion}</span>}
        </time>
        <h1>{letter.data.title}</h1>
        <div class="body">
          <Content />
        </div>
        <p class="signed">&mdash; {letter.data.author}</p>
        <p class="back"><a href="/letters">&larr; Back to all letters</a></p>
      </article>

      <aside class="rail" aria-label="About this letter">
        {readings.length > 0 && (
          <section>
            <p class="rail-label">Appointed readings</p>
            <ul class="readings">
              {readings.map((r) => (
                <li>
                  <a href={`/letters/scripture/${bookSlug(bookOf(r.refKey))}`}>{r.refDisplay}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {tagged.map((facet) => (
          <section>
            <p class="rail-label">{facet.label}</p>
            <div class="chips">
              {facet.tags.map((tag) => (
                <a class="chip" href={`/letters?tag=${facet.key}:${tag}`}>{tagLabel(tag)}</a>
              ))}
            </div>
          </section>
        ))}

        {related.length > 0 && (
          <section>
            <p class="rail-label">Related letters</p>
            <ul class="related">
              {related.map(({ letter: other, shared }) => (
                <li>
                  <a href={`/letters/${other.id}`}>{other.data.title}</a>
                  <span class="why">
                    {[...new Set(shared.map((s) => tagLabel(s.tag)))].slice(0, 2).join(" · ")}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </main>

  <Fragment slot="footer">
    <span class="mark">The Order of Elders &middot; Río Texas</span>
    <blockquote>"To maintain all confidences inviolate." &mdash; &para; 340</blockquote>
    <p>An independent project of the order. Part of <a href="https://orderofelders.org">orderofelders.org</a>.</p>
  </Fragment>
</Base>

<style>
  .mast { border-bottom: 1px solid var(--hair); }
  .mast .rules { height: 10px; background: linear-gradient(var(--red) 0 3px, transparent 3px 7px, var(--red) 7px 10px); }
  .mast .bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 28px; padding: 22px 0; }
  .mast .conf { color: var(--smoke); }
  .mast h1 { font-family: "EB Garamond", serif; font-weight: 600; font-size: 1.5rem; letter-spacing: .01em; }
  .mast h1 a { color: var(--ink); }
  nav { margin-left: auto; display: flex; gap: 22px; flex-wrap: wrap; }
  nav a { font-family: "Archivo", sans-serif; font-weight: 600; font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  nav a:hover { color: var(--red); text-decoration: none; }

  .letter-detail { max-width: 680px; }
  .letter-detail time { display: block; font-family: "Archivo", sans-serif; font-size: .75rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; color: var(--smoke); margin: .6rem 0 .6rem; }
  .letter-detail h1 { font-family: "EB Garamond", serif; font-weight: 600; font-size: 2.4rem; margin-bottom: 1.8rem; line-height: 1.15; }
  .letter-detail .body { font-size: 1.02rem; color: #3B362E; }
  .letter-detail .body :global(p) { margin-bottom: 1.1rem; }
  .letter-detail .body :global(blockquote) {
    border-left: 3px solid var(--gold); padding: 4px 0 4px 22px; margin: 0 0 2rem;
    font-family: "EB Garamond", serif; font-style: italic; font-size: 1.1rem; color: var(--red-deep);
  }
  .letter-detail .body :global(blockquote p) { margin-bottom: .5rem; }
  .letter-detail .body :global(blockquote p:last-child) {
    margin-bottom: 0; font-style: normal;
    font-family: "Archivo", sans-serif; font-size: .7rem; font-weight: 600;
    letter-spacing: .16em; text-transform: uppercase; color: var(--smoke);
  }
  .letter-detail .signed { margin-top: 1.6rem; font-family: "EB Garamond", serif; font-style: italic; color: var(--smoke); }
  .letter-detail time .occ { text-transform: none; letter-spacing: 0; font-family: "EB Garamond", serif; font-style: italic; font-size: .95rem; }

  /* Reading column + a side rail for the apparatus. The rail must never crowd the
     letter: the prose keeps its measure and the rail takes what is left. */
  .letter-layout { display: grid; grid-template-columns: minmax(0, 680px) 232px; gap: 64px; align-items: start; padding: 72px 0 96px; }
  @media (max-width: 1040px) {
    .letter-layout { grid-template-columns: minmax(0, 680px); gap: 0; }
    .rail { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--hair); }
  }

  .rail { position: sticky; top: 32px; }
  @media (max-width: 1040px) { .rail { position: static; } }
  .rail section { margin-bottom: 1.9rem; }
  .rail section:last-child { margin-bottom: 0; }
  .rail-label { font-family: "Archivo", sans-serif; font-size: .64rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--smoke); margin-bottom: .6rem; }

  .readings { list-style: none; padding: 0; margin: 0; }
  .readings li { margin-bottom: .3rem; }
  .readings a { font-family: "EB Garamond", serif; font-size: 1rem; color: var(--red-deep); }
  .readings a:hover { color: var(--red); }

  .chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .chip {
    font-family: "Archivo", sans-serif; font-size: .72rem; padding: 3px 9px;
    border: 1px solid var(--hair); border-radius: 999px; color: var(--ink); line-height: 1.5;
  }
  .chip:hover { border-color: var(--red); color: var(--red); text-decoration: none; }

  .related { list-style: none; padding: 0; margin: 0; }
  .related li { padding: 7px 0; border-bottom: 1px solid var(--hair); }
  .related li:last-child { border-bottom: none; }
  .related a { display: block; font-family: "EB Garamond", serif; font-size: 1rem; color: var(--ink); line-height: 1.3; }
  .related a:hover { color: var(--red); }
  .related .why { display: block; margin-top: .15rem; font-family: "Archivo", sans-serif; font-size: .64rem; letter-spacing: .06em; color: var(--smoke); }

  .letter-detail .back { margin-top: 3rem; }
  .letter-detail .back a { font-family: "Archivo", sans-serif; font-weight: 600; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
</style>
