---
import "../styles/tokens.css";

export type Order = "elders" | "deacons" | "local-pastors";

const SITE_NAMES: Record<Order, string> = {
  elders: "The Order of Elders",
  deacons: "The Order of Deacons",
  "local-pastors": "The Fellowship of Local Pastors and Associate Members",
};

const DEFAULT_DESCRIPTIONS: Record<Order, string> = {
  elders: "An independent project of elders, for elders — letters, prayer, and the calendar of the order, made visible.",
  deacons: "An independent project of deacons, for deacons — prayer and the calendar of the order, made visible.",
  "local-pastors": "An independent project of local pastors and associate members, for local pastors and associate members — prayer and the calendar of the Fellowship, made visible.",
};

interface Props {
  title: string;
  order: Order;
  description?: string;
  image?: string;
  url?: string;
}
const {
  title,
  order,
  description = DEFAULT_DESCRIPTIONS[order],
  image,
  url,
} = Astro.props;
const siteName = SITE_NAMES[order];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Archivo:wght@500;600&display=swap"
    rel="stylesheet"
  />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {url && <meta property="og:url" content={url} />}
  {image && <meta property="og:image" content={image} />}
  {image && <meta property="og:image:width" content="1200" />}
  {image && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={image} />}
</head>
<body>
  <slot />
  <footer>
    <div class="wrap">
      <div class="rule" aria-hidden="true"></div>
      <slot name="footer" />
    </div>
  </footer>
</body>
</html>
